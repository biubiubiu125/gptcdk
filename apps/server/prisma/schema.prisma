generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 后台用户
// ---------------------------------------------------------------------------
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  sessionVersion Int    @default(0)
  displayName  String   @default("管理员")
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// 导入批次（按额度分批）
// ---------------------------------------------------------------------------
model Batch {
  id        Int       @id @default(autoincrement())
  batchId   String    @unique
  credits   Int
  count     Int       @default(0)
  remark    String?
  source    String    @default("paste")
  createdAt DateTime  @default(now())
  accounts  Account[]
}

// ---------------------------------------------------------------------------
// 账号（= 一张卡密）
// ---------------------------------------------------------------------------
model Account {
  id           Int       @id @default(autoincrement())
  name         String
  email        String?
  credits      Int
  cardKey      String    @unique
  cardDisabled Boolean   @default(false)
  planType     String?
  accountId    String?
  userId       String?
  accessToken  String
  refreshToken String?
  idToken      String?
  sessionToken String?
  expiresAt    DateTime?
  rawSource    String    @default("sub2api")
  rawJson      String?

  banStatus    String    @default("unknown")
  banReason    String?
  banKeywords  String?
  banCheckedAt DateTime?

  redeemStatus String    @default("unredeemed")
  redeemedByCard String?
  redeemedAt   DateTime?
  redeemCount  Int       @default(0)
  copyCount    Int       @default(0)
  stagedCredential String?
  refreshHeld      Boolean   @default(false)
  stockKind        String    @default("standard")
  teamStatus       String?
  workspaceId      Int?
  priorUserId      String?
  priorRemoteWorkspaceId String?
  kickedAt         DateTime?

  batchId String?
  remark  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch      Batch?          @relation(fields: [batchId], references: [batchId], onDelete: SetNull)
  mailbox    MailCredential?
  redeemLogs RedeemLog[]
  pickupLogs PickupLog[]
  workspace  TeamWorkspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  teamSecret TeamSecret?
  teamUsage  TeamUsage?

  @@index([credits])
  @@index([banStatus])
  @@index([redeemStatus])
  @@index([redeemedByCard])
  @@index([email])
  @@index([createdAt])
  @@index([stockKind])
  @@index([teamStatus])
  @@index([workspaceId])
  // 未踢出 Team 邮箱的部分唯一索引 Account_team_active_email_key 由启动迁移创建，Prisma 无法表达 WHERE。
}

// ---------------------------------------------------------------------------
// 邮箱取件凭据
// ---------------------------------------------------------------------------
model MailCredential {
  id           Int      @id @default(autoincrement())
  accountId    Int      @unique
  email        String
  provider     String   @default("outlook")
  authType     String   @default("oauth2")
  password     String?
  clientId     String?
  refreshToken String?
  line         String?
  imapHost     String?
  imapPort     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email])
}

// ---------------------------------------------------------------------------
// 兑换日志
// ---------------------------------------------------------------------------
model RedeemLog {
  id        Int      @id @default(autoincrement())
  cardKey   String
  accountId Int?
  credits   Int
  format    String
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  message   String?
  createdAt DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([cardKey])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 取件日志
// ---------------------------------------------------------------------------
model PickupLog {
  id        Int      @id @default(autoincrement())
  accountId Int
  email     String
  ok        Boolean
  banned    Boolean  @default(false)
  credits   Int?
  code      String?
  error     String?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 额度档位（已废弃：不再作为手工维护的字典使用）
//
// 账号额度只来自「邮箱取件命中额度关键字」（档位 = 命中 credits ÷ 25），
// 后台档位分布由 Account.credits 直接聚合派生，本表仅为兼容历史数据保留，
// 新代码不要读写。
// ---------------------------------------------------------------------------
model CreditTier {
  id      Int    @id @default(autoincrement())
  credits Int    @unique
  label   String
  sort    Int    @default(0)
}

// ---------------------------------------------------------------------------
// 键值设置
// ---------------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 服务启动时执行的 PostgreSQL 升级记录。已有 SQLite 文件不会自动迁入。
model SchemaMigration {
  version   Int      @id
  appliedAt DateTime @default(now())
}

// 5x Team 母号空间。母号没有顾客 CDK。
model TeamWorkspace {
  id                 Int       @id @default(autoincrement())
  openaiWorkspaceId  String?   @unique
  motherEmail        String
  displayName        String?
  inviteHold         String?
  sessionCipher      String
  sessionStatus      String    @default("unknown")
  lastSuccessAt      DateTime?
  lastError          String?
  socksCipher        String?
  seatsEntitled      Int?
  memberCount        Int?
  snapshotComplete   Boolean   @default(false)
  snapshotAt         DateTime?
  willRenew          Boolean?
  activeUntil        String?
  remoteMembersJson  String?
  lastInviteAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]
  jobs               TeamJob[]

  @@index([motherEmail])
}

model TeamSecret {
  id             Int      @id @default(autoincrement())
  accountId      Int      @unique
  passwordCipher String
  totpCipher     String
  tokenCipher    String?
  socksCipher    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TeamUsage {
  id            Int       @id @default(autoincrement())
  accountId     Int       @unique
  pct5h         Float?
  reset5h       Int?
  pct7d         Float?
  reset7d       Int?
  limitReached  Boolean?
  allowed       Boolean?
  status        String    @default("unprobed")
  detail        String?
  probedAt      DateTime?
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TeamJob {
  id             Int       @id @default(autoincrement())
  workspaceRowId Int
  kind           String
  status         String    @default("running")
  message        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      TeamWorkspace @relation(fields: [workspaceRowId], references: [id], onDelete: Cascade)

  @@index([workspaceRowId, status])
}
